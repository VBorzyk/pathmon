# Copy to /etc/pathmon/pathmon.env with owner root:root and mode 0600.
# Required only when telegram.chat_id is set in pathmon.yaml.
# Uncomment and set the real token in the installed file, not in Git.
# PATHMON_TELEGRAM_TOKEN=replace-with-your-bot-token

# Optional proxy for Telegram delivery. TCP probes remain direct.
# HTTPS_PROXY=http://127.0.0.1:3128
# NO_PROXY=localhost,127.0.0.1
